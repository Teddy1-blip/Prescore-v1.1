{
  "name": "prescore",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/platform/typecheck.mjs && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "validate:artifact": "node scripts/platform/validate-artifact.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate --config=drizzle.postgres.config.ts",
    "credit-lab": "node --experimental-strip-types scripts/credit-lab.mjs",
    "legacy:dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "legacy:build": "bash scripts/build-verified.sh",
    "legacy:start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "legacy:validate:artifact": "bash scripts/validate-artifact.sh",
    "db:migrate": "node --experimental-strip-types scripts/platform/db-migrate.mjs",
    "auth:bootstrap-admin": "node --experimental-strip-types scripts/platform/bootstrap-admin.mjs",
    "legacy:install:ci": "bash scripts/install-ci.sh",
    "legacy:db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:import": "node --experimental-strip-types scripts/platform/import-d1.mjs",
    "ai:smoke": "node --experimental-strip-types scripts/platform/ai-smoke.mjs",
    "env:check": "node --experimental-strip-types scripts/platform/env-check.mjs",
    "credit-lab:development": "node --experimental-strip-types scripts/credit-lab-development.mjs",
    "credit-lab:business": "node --experimental-strip-types scripts/credit-lab-business.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "fflate": "0.7.4",
    "lucide-react": "^1.25.0",
    "next": "16.2.6",
    "nodemailer": "10.0.10",
    "pdfjs-dist": "^5.4.530",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
