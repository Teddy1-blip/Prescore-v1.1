# Copy to .env.rc; replace placeholders with newly generated local-only secrets.
PRESCORE_RUNTIME_MODE=release-candidate
NODE_ENV=production
DATABASE_URL=postgresql://prescore_rc:REPLACE_LOCAL_PASSWORD@postgres:5432/prescore_rc
AUTH_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
PRESCORE_BASE_URL=http://127.0.0.1:3000
PRESCORE_STORAGE_ROOT=/data/prescore
PRESCORE_ALLOW_RC_FAKE=true
BILLING_PROVIDER=FAKE
BILLING_SETTLEMENT_PROVIDER=FAKE
BILLING_FAKE_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
PARTNER_SETTLEMENT_MODE=PAYOUT_API
BILLING_LIVE_ENABLED=false
BILLING_OFFER_VERSION=rc-offer-v1
BILLING_PRIVACY_VERSION=rc-privacy-v1
MAIL_PROVIDER=POSTGRES_FAKE
AI_PROVIDER=local
PRESCORE_BOOTSTRAP_ADMIN_ENABLED=false
PRESCORE_BOOTSTRAP_ADMIN_EMAIL=
WORKER_INTERVAL_MS=5000
WORKER_BATCH_SIZE=20
