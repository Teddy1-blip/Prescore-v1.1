PRESCORE_RUNTIME_MODE=production
NODE_ENV=production
BILLING_PROVIDER=DISABLED
BILLING_SETTLEMENT_PROVIDER=DISABLED
BILLING_LIVE_ENABLED=false
PARTNER_SETTLEMENT_MODE=ACCRUAL_ONLY
DATABASE_URL=postgresql://USER:PASSWORD@INTERNAL_HOST:5432/prescore
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PRESCORE_BASE_URL=https://STAGING_HOST
PRESCORE_STORAGE_ROOT=/data/prescore
PRESCORE_INTERNAL_REPORT_PREVIEW=0
PRESCORE_BUILD_VERSION=standalone-migration
PRESCORE_BOOTSTRAP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CHECKO_API_KEY=
AI_PROVIDER=local
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Opt-in for the internal synthetic document smoke only.
DEEPSEEK_VISION_MODEL=
AI_QUESTIONS_PER_DAY=30
AI_QUESTIONS_PER_MINUTE=5
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# Set on marketing build only after app.prescore.ru HTTPS is live and accepted.
# Unset => keep existing same-origin links.
NEXT_PUBLIC_PRESCORE_APP_ORIGIN=
